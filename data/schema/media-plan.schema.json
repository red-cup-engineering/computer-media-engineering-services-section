{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/red-cup-engineering/computer-media-engineering-services-section/data/schema/media-plan.schema.json",
  "title": "MediaPlan",
  "$comment": "The one upstream a script -> scenes -> shots -> assets -> captions -> audio -> render target -> publication plan travels in, consumed by BOTH Google Flow queue-order compilation and deterministic (procedural) rendering. Structure only: cross-field rules (references resolve, cues inside shots, speakers in cast, paper link present when required, timing without drift) are the precondition in src/media-plan.mjs admitMediaPlan, which answers coded/pathful refusals, also enforces every closed object shape, and fills defaults only for absent fields. Per-renderer limits belong to target compilation, not this shared plan shape.",
  "type": "object",
  "required": ["kind", "version", "id", "title", "consumer", "source", "scenes"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "MediaPlan" },
    "version": { "const": 1 },
    "id": { "$ref": "#/$defs/slug" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$", "default": "en" },
    "consumer": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 200, "$comment": "The name Flow journals generations under." },
    "purpose": { "type": "string", "maxLength": 500 },
    "destination": { "type": "string", "maxLength": 500 },
    "promptRevision": { "type": "string", "maxLength": 500 },
    "aspect": { "enum": ["9:16", "16:9"], "default": "9:16" },
    "fps": { "type": "integer", "minimum": 1, "maximum": 120, "default": 30, "$comment": "The authoring time base of shot frames and cues." },
    "source": {
      "type": "object",
      "required": ["sourceRevision", "documents"],
      "additionalProperties": false,
      "properties": {
        "sourceRevision": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64}|git:[a-f0-9]{40}|ni:///sha-256;[A-Za-z0-9_-]{43})$" },
        "originRef": { "type": "string", "maxLength": 1000 },
        "documents": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/document" } }
      }
    },
    "links": {
      "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/link" },
      "$comment": "Where a viewer is sent. rel 'paper' is the research paper a video is made from; it lands in the description and on the end card."
    },
    "characters": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/character" } },
    "locations": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/location" } },
    "beats": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/beat" } },
    "scenes": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/scene" } },
    "audio": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "music": { "type": "object", "additionalProperties": false, "properties": { "profile": { "enum": ["none", "harmonic", "psychedelic"], "default": "harmonic" } } },
        "dialogue": { "type": "object", "additionalProperties": false, "properties": { "voice": { "enum": ["none", "rehearsal"], "default": "none" } } }
      }
    },
    "captions": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "derive": { "enum": ["auto", "dialogue", "explicit"], "default": "auto" },
        "burnedIn": { "type": "boolean", "default": true }
      }
    },
    "endCard": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "seconds": { "type": "integer", "minimum": 1, "maximum": 10, "default": 3 },
        "headline": { "type": "string", "maxLength": 300 },
        "text": { "type": "string", "maxLength": 300 },
        "linkRel": { "enum": ["paper", "source", "dataset", "series", "other"], "default": "paper" }
      }
    },
    "render": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "targets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["flow", "deterministic"] }, "default": ["flow", "deterministic"] },
        "width": { "type": "integer", "minimum": 180, "maximum": 1080, "multipleOf": 18, "default": 360 },
        "outputFps": { "type": "integer", "minimum": 8, "maximum": 30, "default": 18 },
        "style": { "enum": ["abstract", "abyssal-glass", "abyssal-psychedelic"], "default": "abstract" },
        "motion": { "enum": ["still", "character-bob", "kinetic-rig"], "default": "still" }
      }
    },
    "publication": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 4000, "pattern": "^[^<>]*$" },
        "tags": { "type": "array", "maxItems": 30, "items": { "type": "string", "minLength": 1, "pattern": "^[^<>,]+$" } },
        "privacy": { "enum": ["private", "unlisted", "public"], "default": "private" },
        "requirePaperLink": { "type": "boolean", "default": false },
        "parentVideoId": { "type": "string", "maxLength": 1000 },
        "categoryId": { "type": "string", "maxLength": 1000 },
        "madeForKids": { "type": "boolean" },
        "aiDisclosure": { "type": "string", "maxLength": 1000 }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$" },
    "ni": { "type": "string", "pattern": "^ni:///sha-256;[A-Za-z0-9_-]{43}$" },
    "locator": {
      "type": "object",
      "properties": {
        "identity": { "$ref": "#/$defs/ni" },
        "url": { "type": "string", "pattern": "^https://[^\\s<>\"]+$", "maxLength": 2000 },
        "doi": { "type": "string", "pattern": "^10\\.\\d{4,9}/[^\\s<>\"]+$" }
      }
    },
    "document": {
      "allOf": [{ "$ref": "#/$defs/locator" }],
      "type": "object",
      "required": ["id", "role"],
      "anyOf": [{ "required": ["identity"] }, { "required": ["url"] }, { "required": ["doi"] }],
      "unevaluatedProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" }, "role": { "$ref": "#/$defs/slug" },
        "title": { "type": "string", "maxLength": 1000 }, "rightsRef": { "type": "string", "maxLength": 1000 }, "citation": { "type": "string", "maxLength": 1000 },
        "identity": true, "url": true, "doi": true
      }
    },
    "link": {
      "allOf": [{ "$ref": "#/$defs/locator" }],
      "type": "object",
      "required": ["rel"],
      "anyOf": [{ "required": ["documentId"] }, { "required": ["identity"] }, { "required": ["url"] }, { "required": ["doi"] }],
      "unevaluatedProperties": false,
      "properties": {
        "rel": { "enum": ["paper", "source", "dataset", "series", "other"] },
        "documentId": { "$ref": "#/$defs/slug" }, "label": { "type": "string", "maxLength": 200 },
        "identity": true, "url": true, "doi": true
      }
    },
    "character": {
      "type": "object", "required": ["id"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/slug" }, "name": { "type": "string", "maxLength": 500 }, "synthetic": { "type": "boolean" }, "visualRef": { "type": "string", "maxLength": 500 }, "voiceRef": { "type": "string", "maxLength": 500 } }
    },
    "location": {
      "type": "object", "required": ["id"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/slug" }, "name": { "type": "string", "maxLength": 200 } }
    },
    "beat": {
      "type": "object", "required": ["id", "causeBeatId", "action", "consequence"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/slug" }, "causeBeatId": { "$ref": "#/$defs/slug" }, "action": { "type": "string" }, "consequence": { "type": "string" }, "kind": { "type": "string" }, "question": { "type": "string" } }
    },
    "scene": {
      "type": "object", "required": ["id", "shots"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/slug" }, "title": { "type": "string", "maxLength": 200 }, "shots": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/shot" } } }
    },
    "cue": {
      "type": "object", "required": ["startFrame", "endFrame", "text"], "additionalProperties": false,
      "properties": { "speakerId": { "$ref": "#/$defs/slug" }, "startFrame": { "type": "integer", "minimum": 0 }, "endFrame": { "type": "integer", "minimum": 1 }, "text": { "type": "string", "minLength": 1, "maxLength": 2000 } }
    },
    "shot": {
      "type": "object", "required": ["id", "frames", "action"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" }, "beatId": { "$ref": "#/$defs/slug" }, "locationId": { "$ref": "#/$defs/slug" },
        "frames": { "type": "integer", "minimum": 1, "maximum": 36000 },
        "characterIds": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
        "camera": { "type": "string", "maxLength": 1000 }, "action": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "claim": { "type": "string", "maxLength": 4000, "$comment": "The exact source statement the shot is grounded in." },
        "ambience": { "type": "string", "maxLength": 1000 },
        "dialogue": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/cue", "required": ["speakerId", "startFrame", "endFrame", "text"] } },
        "captions": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/cue" }, "$comment": "Exact on-screen caption text composited afterward; never drawn by a generative model." },
        "visual": { "$ref": "#/$defs/visual" }
      }
    },
    "visual": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["generative", "deterministic", "either"], "default": "either" },
        "prompt": { "type": "string", "maxLength": 6000 },
        "minSeconds": { "type": "integer", "minimum": 1, "maximum": 60 },
        "referenceImages": {
          "type": "array", "minItems": 1, "maxItems": 3,
          "items": { "type": "object", "required": ["label", "kind", "identity"], "additionalProperties": false, "properties": { "label": { "$ref": "#/$defs/slug" }, "kind": { "enum": ["character", "environment", "object"] }, "identity": { "$ref": "#/$defs/ni" } } },
          "$comment": "Refused for target flow while the wire client is text-to-video only."
        },
        "generated": {
          "type": "array", "maxItems": 16,
          "items": { "type": "object", "required": ["completion", "output"], "additionalProperties": false, "properties": { "completion": { "$ref": "#/$defs/ni" }, "output": { "$ref": "#/$defs/ni" }, "prompt": { "$ref": "#/$defs/ni" }, "mimeType": { "type": "string" }, "bytes": { "type": "integer", "minimum": 0 } } },
          "$comment": "Accepted generations already on file (MediaArtifactWorkCompletion ids); these are explicit author-accepted shot associations, unlike inferred journal reuse. A matching prompt (when supplied), video MIME (when supplied) and positive bytes (when supplied) are needed to suppress a new video order."
        },
        "assets": {
          "type": "array", "maxItems": 16,
          "items": {
            "type": "object", "required": ["id", "role"], "additionalProperties": false,
            "anyOf": [{ "required": ["svg"] }, { "required": ["identity"] }],
            "properties": {
              "id": { "$ref": "#/$defs/slug" }, "role": { "enum": ["frame", "overlay"] }, "mediaType": { "const": "image/svg+xml" },
              "svg": { "type": "string", "maxLength": 400000, "$comment": "Executable admission requires media-inert-svg/1; see media-inert-svg-profile.md. JSON Schema describes the string slot, not the closed asset grammar." }, "identity": { "$ref": "#/$defs/ni" },
              "producer": { "type": "object", "required": ["service"], "additionalProperties": false, "properties": { "service": { "type": "string" }, "spec": { "type": "string" } } }
            }
          },
          "$comment": "Deterministic SVG frames (role frame replaces the scene art) and overlays (composited over it). procedural-previs/1 refuses more than one frame per shot; the common plan retains its wider asset capacity. Examples include from deterministic-report-graphic-service or chart-specification-rendering-service."
        }
      }
    }
  }
}
