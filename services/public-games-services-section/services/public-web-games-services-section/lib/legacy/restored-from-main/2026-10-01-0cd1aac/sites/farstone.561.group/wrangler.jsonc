{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "farstone",
  "main": "./dist/worker.mjs",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "farstone.561.group", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "WORLD", "class_name": "FarstoneWorld" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FarstoneWorld"] }
  ]
}
