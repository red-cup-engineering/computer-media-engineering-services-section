{
  "name": "@causeway-services/vaultmaze-service",
  "version": "0.1.0",
  "type": "module",
  "description": "VaultMaze is a walkable knowledge map lit by FSRS-lite spaced repetition.",
  "scripts": {
    "test": "node --test web/test/*.test.mjs",
    "compile:weiqi": "node scripts/vaultmaze.mjs \"$WEIQI_ROOT\" --dialect house --wing weiqi --no-serve",
    "serve:web": "node web/server.mjs",
    "vaultmaze": "node scripts/vaultmaze.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "dependencies": {
    "@red-cup-engineering/computer-web-server": "0.6.0",
    "@red-cup-engineering/education-platform-service": "0.2.5",
    "@red-cup-engineering/knowledge-system-server": "0.1.0",
    "@red-cup-engineering/markdown-engineering-services-section": "0.5.0"
  }
}
