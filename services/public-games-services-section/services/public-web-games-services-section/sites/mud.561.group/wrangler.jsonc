{
  "name": "mud-561-group",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-04",
  "workers_dev": false,
  "preview_urls": false,
  // The directory queries the published game records; only styling and the
  // authored keyword selection remain as assets.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "routes": [{ "pattern": "mud.561.group", "custom_domain": true }]
}
